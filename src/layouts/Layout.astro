---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  applicationSchema?: boolean;
}

const { title, description, applicationSchema = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(base, Astro.site).href;
const image = new URL(`${base}social.png`, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Remote',
  description: 'A local TV remote for iPhone and iPad, with LG webOS and Samsung Tizen support, QR setup sharing, and per-TV shortcuts. Compatibility varies by TV and firmware.',
  operatingSystem: 'iOS 26 or later; iPadOS 26 or later',
  applicationCategory: 'UtilitiesApplication',
  url: home,
  image,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}favicon.png`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Remote" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Remote. A plain TV remote for iPhone and iPad." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Remote. A plain TV remote for iPhone and iPad." />
    {applicationSchema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href={base} aria-label="Remote home">Remote<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#features`}>Features</a>
        <a href={`${base}support/`} aria-current={Astro.url.pathname === `${base}support/` ? 'page' : undefined}>Support</a>
      </nav>
    </header>
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <p>Remote. Keep it local.</p>
      <nav aria-label="Footer navigation">
        <a href={`${base}privacy/`} aria-current={Astro.url.pathname === `${base}privacy/` ? 'page' : undefined}>Privacy</a>
        <a href={`${base}support/`}>Support</a>
        <a href="https://github.com/jtvargas/remote-website">Website source</a>
      </nav>
    </footer>
  </body>
</html>
